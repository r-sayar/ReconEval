nextflow.enable.dsl = 2

process {
  executor = 'local'
}

docker {
  enabled = true
}

profiles {
  docker {
    docker.enabled = true
    process.container = 'ubuntu:22.04'
  }

  // Opt-in caps for a workstation/laptop. The task's component labels request
  // HPC-sized resources (up to 30 CPUs / 100 GB) which the local executor
  // rejects on a small machine ("requirement exceeds available"). Add this
  // profile — e.g. `-profile docker,laptop` — to clamp every process down to
  // what a laptop has. Tune the numbers to your machine; NOT applied by default.
  laptop {
    process.resourceLimits = [ cpus: 8, memory: '12.GB', time: '4.h' ]
  }
}
